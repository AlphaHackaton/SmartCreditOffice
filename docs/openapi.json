{
  "openapi": "3.1.0",
  "info": {
    "title": "Smart Credit Office API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/demo/personas": {
      "get": {
        "tags": [
          "demo"
        ],
        "summary": "Personas",
        "operationId": "personas_api_v1_demo_personas_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PersonaOut"
                  },
                  "type": "array",
                  "title": "Response Personas Api V1 Demo Personas Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Me",
        "operationId": "me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/applications": {
      "get": {
        "tags": [
          "applications"
        ],
        "summary": "List Applications",
        "operationId": "list_applications_api_v1_applications_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationListOut"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "applications"
        ],
        "summary": "Create Application",
        "operationId": "create_application_api_v1_applications_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/applications/{application_id}/submit": {
      "post": {
        "tags": [
          "applications"
        ],
        "summary": "Submit Application",
        "operationId": "submit_application_api_v1_applications__application_id__submit_post",
        "parameters": [
          {
            "name": "application_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Application Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApplicationIn": {
        "properties": {
          "product_code": {
            "type": "string",
            "minLength": 1,
            "title": "Product Code"
          },
          "amount": {
            "type": "string",
            "format": "decimal",
            "title": "Amount"
          },
          "term_months": {
            "type": "integer",
            "maximum": 60.0,
            "minimum": 1.0,
            "title": "Term Months"
          },
          "purpose": {
            "type": "string",
            "title": "Purpose",
            "default": "WORKING_CAPITAL"
          }
        },
        "type": "object",
        "required": [
          "product_code",
          "amount",
          "term_months"
        ],
        "title": "ApplicationIn"
      },
      "ApplicationListOut": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ApplicationOut"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "ApplicationListOut"
      },
      "ApplicationOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "company_id": {
            "type": "string",
            "format": "uuid",
            "title": "Company Id"
          },
          "product_code": {
            "type": "string",
            "title": "Product Code"
          },
          "amount": {
            "type": "string",
            "format": "decimal",
            "title": "Amount"
          },
          "term_months": {
            "type": "integer",
            "title": "Term Months"
          },
          "status": {
            "$ref": "#/components/schemas/ApplicationStatus"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/StatusEventOut"
            },
            "type": "array",
            "title": "History"
          },
          "decision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DecisionOut"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "company_id",
          "product_code",
          "amount",
          "term_months",
          "status",
          "version"
        ],
        "title": "ApplicationOut"
      },
      "ApplicationStatus": {
        "type": "string",
        "enum": [
          "DRAFT",
          "SUBMITTED",
          "SCORING",
          "UNDERWRITING",
          "APPROVED",
          "COUNTER_OFFER",
          "REJECTED",
          "SIGNING",
          "SIGNED",
          "DISBURSED",
          "CANCELLED",
          "EXPIRED"
        ],
        "title": "ApplicationStatus",
        "description": "Статусы заявки (FSM, 12 статусов, 20 рёбер)."
      },
      "DecisionOut": {
        "properties": {
          "outcome": {
            "$ref": "#/components/schemas/Outcome"
          },
          "route": {
            "$ref": "#/components/schemas/Route"
          },
          "score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "grade": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Grade"
              },
              {
                "type": "null"
              }
            ]
          },
          "factors": {
            "items": {
              "$ref": "#/components/schemas/FactorOut"
            },
            "type": "array",
            "title": "Factors"
          },
          "offers": {
            "items": {
              "$ref": "#/components/schemas/OfferOut"
            },
            "type": "array",
            "title": "Offers"
          },
          "binding_constraint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Binding Constraint"
          },
          "top_reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Top Reasons"
          }
        },
        "type": "object",
        "required": [
          "outcome",
          "route"
        ],
        "title": "DecisionOut"
      },
      "FactorOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "value": {
            "type": "string",
            "title": "Value"
          },
          "points": {
            "type": "integer",
            "title": "Points"
          },
          "max_points": {
            "type": "integer",
            "title": "Max Points"
          },
          "impact": {
            "type": "string",
            "title": "Impact"
          },
          "rule_id": {
            "type": "string",
            "title": "Rule Id"
          },
          "client_text": {
            "type": "string",
            "title": "Client Text",
            "default": ""
          },
          "hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hint"
          }
        },
        "type": "object",
        "required": [
          "code",
          "source",
          "value",
          "points",
          "max_points",
          "impact",
          "rule_id"
        ],
        "title": "FactorOut"
      },
      "Grade": {
        "type": "string",
        "enum": [
          "A",
          "B",
          "C",
          "D"
        ],
        "title": "Grade",
        "description": "Кредитный грейд по итогу скоринга."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthOut": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          }
        },
        "type": "object",
        "required": [
          "mode"
        ],
        "title": "HealthOut"
      },
      "LoginIn": {
        "properties": {
          "login": {
            "type": "string",
            "minLength": 1,
            "title": "Login"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "login",
          "password"
        ],
        "title": "LoginIn"
      },
      "LoginOut": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "user"
        ],
        "title": "LoginOut"
      },
      "OfferOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "amount": {
            "type": "string",
            "format": "decimal",
            "title": "Amount"
          },
          "term_months": {
            "type": "integer",
            "title": "Term Months"
          },
          "rate_pct": {
            "type": "string",
            "format": "decimal",
            "title": "Rate Pct"
          },
          "monthly_payment": {
            "type": "string",
            "format": "decimal",
            "title": "Monthly Payment"
          },
          "overpayment": {
            "type": "string",
            "format": "decimal",
            "title": "Overpayment"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "amount",
          "term_months",
          "rate_pct",
          "monthly_payment",
          "overpayment",
          "expires_at"
        ],
        "title": "OfferOut"
      },
      "Outcome": {
        "type": "string",
        "enum": [
          "APPROVED",
          "COUNTER_OFFER",
          "REJECTED"
        ],
        "title": "Outcome",
        "description": "Рекомендация по заявке."
      },
      "PersonaOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "login": {
            "type": "string",
            "title": "Login"
          },
          "company_name": {
            "type": "string",
            "title": "Company Name"
          },
          "inn": {
            "type": "string",
            "title": "Inn"
          },
          "legal_form": {
            "type": "string",
            "title": "Legal Form"
          },
          "expected_outcome": {
            "$ref": "#/components/schemas/Outcome"
          }
        },
        "type": "object",
        "required": [
          "id",
          "login",
          "company_name",
          "inn",
          "legal_form",
          "expected_outcome"
        ],
        "title": "PersonaOut"
      },
      "Route": {
        "type": "string",
        "enum": [
          "AUTO",
          "UNDERWRITING"
        ],
        "title": "Route",
        "description": "Маршрут решения: авто или ручная проверка."
      },
      "StatusEventOut": {
        "properties": {
          "from_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ApplicationStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "to_status": {
            "$ref": "#/components/schemas/ApplicationStatus"
          },
          "actor": {
            "type": "string",
            "title": "Actor"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "title": "At"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "from_status",
          "to_status",
          "actor",
          "at"
        ],
        "title": "StatusEventOut"
      },
      "UserOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "login": {
            "type": "string",
            "title": "Login"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "company_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "login",
          "role"
        ],
        "title": "UserOut"
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "CLIENT",
          "BANK"
        ],
        "title": "UserRole"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
