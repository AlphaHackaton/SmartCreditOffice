  "components": {
    "schemas": {
      "ApplicationIn": {
        "properties": {
          "product_code": {
            "type": "string",
            "minLength": 1,
            "title": "Product Code"
          },
          "amount": {
            "type": "string",
            "format": "decimal",
            "title": "Amount"
          },
          "term_months": {
            "type": "integer",
            "maximum": 60.0,
            "minimum": 1.0,
            "title": "Term Months"
          },
          "purpose": {
            "type": "string",
            "title": "Purpose",
            "default": "WORKING_CAPITAL"
          }
        },
        "type": "object",
        "required": [
          "product_code",
          "amount",
          "term_months"
        ],
        "title": "ApplicationIn"
      },
      "ApplicationListOut": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ApplicationOut"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "ApplicationListOut"
      },
      "ApplicationOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "company_id": {
            "type": "string",
            "format": "uuid",
            "title": "Company Id"
          },
          "product_code": {
            "type": "string",
            "title": "Product Code"
          },
          "amount": {
            "type": "string",
            "format": "decimal",
            "title": "Amount"
          },
          "term_months": {
            "type": "integer",
            "title": "Term Months"
          },
          "status": {
            "$ref": "#/components/schemas/ApplicationStatus"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/StatusEventOut"
            },
            "type": "array",
            "title": "History"
          },
          "decision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DecisionOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "selected_offer": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OfferOut"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "company_id",
          "product_code",
          "amount",
          "term_months",
          "status",
          "version"
        ],
        "title": "ApplicationOut"
      },
      "ApplicationStatus": {
        "type": "string",
        "enum": [
          "DRAFT",
          "SUBMITTED",
          "SCORING",
          "UNDERWRITING",
          "APPROVED",
          "COUNTER_OFFER",
          "REJECTED",
          "SIGNING",
          "SIGNED",
          "DISBURSED",
          "CANCELLED",
          "EXPIRED"
        ],
        "title": "ApplicationStatus",
        "description": "Статусы заявки (FSM, 12 статусов, 20 рёбер)."
      },
      "BankApplicationSummary": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "company_id": {
            "type": "string",
            "format": "uuid",
            "title": "Company Id"
          },
          "status": {
            "$ref": "#/components/schemas/ApplicationStatus"
          },
          "product_code": {
            "type": "string",
            "title": "Product Code"
          },
          "amount": {
            "type": "string",
            "format": "decimal",
            "title": "Amount"
          },
          "term_months": {
            "type": "integer",
            "title": "Term Months"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "id",
          "company_id",
          "status",
          "product_code",
          "amount",
          "term_months",
          "version"
        ],
        "title": "BankApplicationSummary"
      },
      "BankDossierOut": {
        "properties": {
          "application": {
            "$ref": "#/components/schemas/ApplicationOut"
          },
          "inputs_snapshot": {
            "additionalProperties": true,
            "type": "object",
            "title": "Inputs Snapshot"
          },
          "audit": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Audit"
          }
        },
        "type": "object",
        "required": [
          "application"
        ],
        "title": "BankDossierOut"
      },
      "BankQueueOut": {
        "properties": {
          "items": {
