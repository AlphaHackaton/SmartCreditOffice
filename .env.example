# Шаблон для будущего API-сервера. Файл .env в git не добавлять.
# Текущий доменный backend не читает переменные окружения.
# LLM необязателен: без него приложение должно работать по правилам.
# Заполнять только при подключении локальной open-weights модели.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=
