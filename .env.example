# Переменные окружения (шаблон)
# Скопируйте в .env для локальной разработки
APP_MODE=stub
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
BACKEND_PORT=8000
FRONTEND_PORT=8080
POSTGRES_DB=credit
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit
KEY_RATE_PCT=16.5

# Optional OpenAI-compatible open-weights explainer. The decision engine never depends on it.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# База данных (Dev 2+)
DATABASE_URL=postgresql+psycopg://credit:credit@localhost:5432/credit